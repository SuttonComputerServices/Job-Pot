# Copy to .env and edit. Never commit .env.
# Optional: a fixed master key (32+ random characters). If empty, one is generated into the data volume.
# Back it up: without it, saved site and mailbox passwords can't be decrypted.
JOBPOT_SECRET_KEY=
# Port on the host.
JOBPOT_PORT=8000
# Set to 1 when Job Pot is served over HTTPS (behind a reverse proxy) so cookies are Secure-only.
JOBPOT_HTTPS=0
# Seconds between background runs.
JOBPOT_WORKER_INTERVAL=900
# With "docker compose --profile ai up -d" use http://ollama:11434
OLLAMA_URL=
OLLAMA_MODEL=llama3.1:8b
