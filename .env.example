# Copy to .env and edit. Never commit .env.
# Optional: a fixed master key (32+ random characters). If empty, one is generated into the data volume.
# Back it up: without it, saved site and mailbox passwords can't be decrypted.
JOBPOT_SECRET_KEY=
# Host address and port to publish on. 127.0.0.1 = this machine only (use an HTTPS reverse proxy for other devices).
# 0.0.0.0 = every network interface over plain HTTP: passwords cross the network unencrypted. Only on a network you trust.
JOBPOT_BIND=127.0.0.1
JOBPOT_PORT=8000
# Set to 1 when Job Pot is served over HTTPS (behind a reverse proxy) so cookies are Secure-only.
JOBPOT_HTTPS=0
# Set to 1 if your mailbox is on a server in your own network (private IP address).
JOBPOT_ALLOW_PRIVATE_MAIL_HOSTS=0
# Seconds between background runs.
JOBPOT_WORKER_INTERVAL=900
# With "docker compose --profile ai up -d" use http://ollama:11434
OLLAMA_URL=
OLLAMA_MODEL=llama3.1:8b
